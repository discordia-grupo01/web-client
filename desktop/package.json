{
  "name": "discordia-desktop",
  "productName": "Discordia",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente de escritorio de Discordia",
  "author": "Grupo 1",
  "homepage": "https://github.com/discordia-grupo01/web-client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.discordia.desktop",
    "productName": "Discordia",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "offline.html",
      "icon.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Network",
      "maintainer": "Discordia Grupo 1"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
