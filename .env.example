# URL del Gateway (Kong). Nunca apuntar directo a un microservicio.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Opcional. URL del WebSocket de mensajes (el unico acceso al gateway que hace el
# navegador directo). Por defecto sale de NEXT_PUBLIC_API_URL cambiando http por
# ws. Definirla solo si el navegador ve el gateway en otra direccion que el
# servidor de Next (por ejemplo con Docker: ws://localhost:8000/socket).
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/socket

# Client ID de tipo "Web application" (Google Cloud Console > APIs y servicios >
# Credenciales). Tiene que coincidir con el GOOGLE_CLIENT_ID que usa el backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
